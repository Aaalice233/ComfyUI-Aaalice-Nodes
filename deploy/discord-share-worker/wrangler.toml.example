name = "aaalice-discord-share"
main = "worker.js"
compatibility_date = "2026-07-30"

[[kv_namespaces]]
binding = "SESSIONS"
id = "replace-with-kv-namespace-id"

[[ratelimits]]
name = "SHARE_RATE_LIMITER"
# Must be a positive integer string unique within this Cloudflare account.
namespace_id = "replace-with-unique-positive-integer"

  [ratelimits.simple]
  limit = 8
  period = 60

[vars]
DISCORD_CLIENT_ID = "replace-with-discord-application-id"
DISCORD_GUILD_ID = "replace-with-discord-server-id"
DISCORD_INVITE_URL = "https://discord.gg/replace-me"
ALLOWED_ORIGINS = ""
# Optional comma-separated role IDs. Empty means every server member can share.
ALLOWED_ROLE_IDS = ""
SESSION_TTL_SECONDS = "2592000"

# Add these with `wrangler secret put`, never under [vars]:
# DISCORD_CLIENT_SECRET
# DISCORD_WEBHOOK_TARGETS
# STATE_SECRET
